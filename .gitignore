# Private local inputs and generated validation outputs (never publish these).
validation/*.local.json
validation/.generated/
dev/.state/
**/node_modules/
**/.wrangler/
**/.dev.vars
**/.dev.vars.*
**/.env
**/.env.local
**/.env.*.local
# Production backup data must remain outside Git.
**/yasoya-orders*.sql
**/restore-verification.sqlite
**/backup-verification.json

# Never commit a real release profile.
production/release/*.local.jsonc
